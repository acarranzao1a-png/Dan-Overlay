/backups/
*.bak
*.bak_*
*.bak-*
*.rejected_*
*.orig

# PyInstaller specs (generated into build\spec via --specpath; never tracked)
*.spec

# In-development skins
prototype/

# Local tooling & user settings
/.vscode/
.codetogether.ignore
config/settings.json

# Binaries built by the project
*.exe
!tools/bin/msd.exe
!src/01_overlay_ui/ffmpeg/ffmpeg.exe
