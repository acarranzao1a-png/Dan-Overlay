# Local data & large assets
/archive/
/data/

# Local test workspace
/tests/
/scripts/

# Python environment
/.venv/
__pycache__/
*.pyc
*.pyo

# Build artifacts
/build/
/dist/

# Backups & residue
*.backup*
backup_pre_cleanup.bat
b64.txt

# Backups relocated out of src\ and config\ (kept locally, never published).
